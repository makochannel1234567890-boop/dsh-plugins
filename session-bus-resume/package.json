{
  "name": "dsh-session-bus-resume",
  "version": "0.1.0",
  "description": "One-shot host-side resume sweep for the sessions stopped by dsh-session-bus-control. Sends the resume prompt to every recorded session in one pass.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/ja.json",
    "icon.svg"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
